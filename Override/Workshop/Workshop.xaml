<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:api="clr-namespace:APIShared.ModSettings;assembly=APIShared" xmlns:seui="clr-namespace:SHCDESE.UI;assembly=SHCDESE" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" api:ModSettingsSearch.Exclude="True">
  <ScrollViewer.Resources>
    <Style TargetType="{x:Type ToolTip}">
      <Setter Property="Background" Value="#FF1D1710"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#FFF2D48A"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="seui:ToolTipResolutionScale.Enabled" Value="True"/>
      <Setter Property="FontSize" Value="{x:Static api:ToolTipPresentation.FontSize}"/><Setter Property="MaxWidth" Value="{x:Static api:ToolTipPresentation.MaximumWidth}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ToolTip}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}" MaxWidth="{TemplateBinding MaxWidth}"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" TextWrapping="Wrap"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
  </ScrollViewer.Resources>
  <StackPanel Margin="24" MinWidth="700">
    <TextBlock Text="APIShared Workshop" FontSize="26" Foreground="#FFF2D48A"/>
    <TextBlock Text="{Binding Ownership}" TextWrapping="Wrap" Margin="0,8,0,16"/>
    <TabControl>
      <TabItem Header="{Binding InstalledTitle}" ToolTip="{Binding InstalledTitle}" ToolTipService.ShowDuration="60000">
        <StackPanel Margin="12">
          <Button Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" ToolTip="{Binding RefreshLabel}" ToolTipService.ShowDuration="60000"/>
          <ComboBox ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}" DisplayMemberPath="Title" Margin="0,8" ToolTip="{Binding InstalledTitle}" ToolTipService.ShowDuration="60000"/>
          <TextBlock Text="{Binding SelectedInfo}" TextWrapping="Wrap" Margin="0,8"/>
          <Button Content="{Binding PrepareLabel}" Command="{Binding PrepareCommand}" ToolTip="{Binding PrepareLabel}" ToolTipService.ShowDuration="60000"/>
          <Button Content="{Binding ReinstallLabel}" Command="{Binding ReinstallCommand}" ToolTip="{Binding ReinstallLabel}" ToolTipService.ShowDuration="60000"/>
          <Button Content="{Binding DowngradeLabel}" Command="{Binding DowngradeCommand}" ToolTip="{Binding DowngradeLabel}" ToolTipService.ShowDuration="60000"/>
          <Button Content="{Binding RemoveLabel}" Command="{Binding RemoveCommand}" ToolTip="{Binding RemoveLabel}" ToolTipService.ShowDuration="60000"/>
          <Button Content="{Binding ApplyLabel}" Command="{Binding ApplyCommand}" Margin="0,12" ToolTip="{Binding ApplyLabel}" ToolTipService.ShowDuration="60000"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="{Binding PublishingTitle}" ToolTip="{Binding PublishingTitle}" ToolTipService.ShowDuration="60000">
        <StackPanel Margin="12">
          <TextBlock Text="{Binding SourceLabel}"/><TextBox Text="{Binding SourceDirectory, Mode=TwoWay}" ToolTip="{Binding SourceLabel}" ToolTipService.ShowDuration="60000"/>
          <TextBlock Text="{Binding DraftLabel}" TextWrapping="Wrap"/>
          <TextBox Text="{Binding PackageId, Mode=TwoWay}" ToolTip="{Binding DraftLabel}" ToolTipService.ShowDuration="60000"/>
          <TextBox Text="{Binding PackageVersion, Mode=TwoWay}" ToolTip="{Binding DraftLabel}" ToolTipService.ShowDuration="60000"/>
          <TextBox Text="{Binding MinimumAPISharedVersion, Mode=TwoWay}" ToolTip="{Binding DraftLabel}" ToolTipService.ShowDuration="60000"/>
          <Button Content="{Binding OwnedLabel}" Command="{Binding OwnedCommand}" Margin="0,8" ToolTip="{Binding OwnedLabel}" ToolTipService.ShowDuration="60000"/>
          <ComboBox ItemsSource="{Binding OwnedItems}" SelectedItem="{Binding SelectedOwnedItem}" DisplayMemberPath="Title" ToolTip="{Binding OwnedLabel}" ToolTipService.ShowDuration="60000"/>
          <TextBlock Text="{Binding ItemLabel}"/><TextBox Text="{Binding ItemId, Mode=TwoWay}" ToolTip="{Binding ItemLabel}" ToolTipService.ShowDuration="60000"/>
          <TextBlock Text="{Binding TitleLabel}"/><TextBox Text="{Binding Title, Mode=TwoWay}" ToolTip="{Binding TitleLabel}" ToolTipService.ShowDuration="60000"/>
          <TextBlock Text="{Binding DescriptionLabel}"/><TextBox Text="{Binding Description, Mode=TwoWay}" AcceptsReturn="True" MinHeight="80" ToolTip="{Binding DescriptionLabel}" ToolTipService.ShowDuration="60000"/>
          <TextBlock Text="{Binding PreviewLabel}"/><TextBox Text="{Binding PreviewFile, Mode=TwoWay}" ToolTip="{Binding PreviewLabel}" ToolTipService.ShowDuration="60000"/>
          <TextBlock Text="{Binding ChangeLabel}"/><TextBox Text="{Binding ChangeNote, Mode=TwoWay}" ToolTip="{Binding ChangeLabel}" ToolTipService.ShowDuration="60000"/>
          <TextBlock Text="{Binding VisibilityLabel}"/><ComboBox ItemsSource="{Binding Visibilities}" SelectedItem="{Binding Visibility}" ToolTip="{Binding VisibilityLabel}" ToolTipService.ShowDuration="60000"/>
          <CheckBox Content="{Binding MetadataLabel}" IsChecked="{Binding MetadataOnly, Mode=TwoWay}" ToolTip="{Binding MetadataLabel}" ToolTipService.ShowDuration="60000"/>
          <Button Content="{Binding PrepareUploadLabel}" Command="{Binding PrepareUploadCommand}" Margin="0,8" ToolTip="{Binding PrepareUploadLabel}" ToolTipService.ShowDuration="60000"/>
          <TextBlock Text="{Binding Terms}" TextWrapping="Wrap"/>
          <Button Content="{Binding TermsLabel}" Command="{Binding TermsCommand}" ToolTip="{Binding Terms}" ToolTipService.ShowDuration="60000"/>
          <Button Content="{Binding PublishLabel}" Command="{Binding PublishCommand}" ToolTip="{Binding PublishLabel}" ToolTipService.ShowDuration="60000"/>
          <Button Content="{Binding ProgressLabel}" Command="{Binding ProgressCommand}" ToolTip="{Binding ProgressLabel}" ToolTipService.ShowDuration="60000"/>
        </StackPanel>
      </TabItem>
    </TabControl>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,16"/>
  </StackPanel>
</ScrollViewer>
