<?xml version="1.0" encoding="utf-8"?>
<Patch xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CrusaderDE">
  <Operation Type="Replace" XPath="//n:Button[@Name='ButtonQuitMission']"><Content>
    <Grid x:Name="APISharedIngameMenuActions" Width="367.5" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
<Button
                    Name="ButtonQuitMission"
                    Width="300"
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding IngameMessageQuitButtonText}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonIngameMenuCommand}"
                    CommandParameter="6"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSDisable}" />
    </Grid>
  </Content></Operation>
</Patch>
