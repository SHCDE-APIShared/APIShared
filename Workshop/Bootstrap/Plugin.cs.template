using BepInEx;
using BepInEx.Bootstrap;
using BepInEx.Logging;
using SHCDESE.API.LowLevel;
using System;
using System.Diagnostics;
using System.Runtime.InteropServices;
using System.Reflection;
using System.IO;

// Generate one dedicated GUID/folder per item. No reference to the APIShared assembly is required.
[BepInPlugin("@@GUID@@", "@@NAME@@ Workshop bootstrap", "@@VERSION@@")]
[BepInDependency("000shcdese", "2.14.0")]
[BepInDependency("APIShared_Serp", BepInDependency.DependencyFlags.SoftDependency)]
public sealed class WorkshopBootstrap : BaseUnityPlugin
{
    private static ManualLogSource log;
    [DllImport("user32.dll", CharSet = CharSet.Unicode)] private static extern int MessageBoxW(IntPtr window, string text, string caption, uint type);
    private void Awake()
    {
        log = Logger;
        CrusaderLibrary.Instance.LibraryLoaded += context => log.LogInfo("Workshop bootstrap active after startup cleanup: @@GUID@@");
        if (CentralAPISharedReady()) return;
        APIShared.Localization.GameLocale.Initialize();
        APIShared.Localization.UiText.Configure(APIShared.Localization.GameLocale.Current);
        string text = APIShared.Localization.UiText.Get("Bootstrap.Required", "Name", "@@NAME@@", "Minimum", "@@MINIMUM@@");
        log.LogWarning(text);
        if (MessageBoxW(IntPtr.Zero, text, APIShared.Localization.UiText.Get("Bootstrap.Title"), 0x34) == 6)
            Process.Start(new ProcessStartInfo("https://steamcommunity.com/sharedfiles/filedetails/?id=@@WORKSHOP@@") { UseShellExecute = true });
    }

    private static bool CentralAPISharedReady()
    {
        try {
            PluginInfo api;
            if (!Chainloader.PluginInfos.TryGetValue("APIShared_Serp", out api) || api.Metadata.Version < new Version("@@MINIMUM@@")) return false;
            string central = Path.GetFullPath(Path.Combine(Paths.PluginPath, "APIShared_Serp", "APIShared.dll"));
            if (!Path.GetFullPath(api.Location).Equals(central, StringComparison.OrdinalIgnoreCase)) return false;
            // LoadFrom may return an already loaded assembly with the same identity.
            // Its actual location, rather than the requested path, decides readiness.
            Assembly loaded = Assembly.LoadFrom(api.Location);
            return Path.GetFullPath(loaded.Location).Equals(central, StringComparison.OrdinalIgnoreCase) &&
                loaded.GetName().Version >= new Version("@@MINIMUM@@") &&
                loaded.GetType("APIShared.Workshop.WorkshopClient", false) != null;
        } catch (Exception ex) { log.LogWarning("Central APIShared could not be verified: " + ex.Message); return false; }
    }
}
