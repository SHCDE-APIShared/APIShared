<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <AssemblyName>APIShared.AllocationTrace</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseSharedCompilation>false</UseSharedCompilation>
    <!-- This diagnostic stays outside Core.Tests' dependency graph. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exact official package/tag: nuget.org/packages/Microsoft.Diagnostics.Tracing.TraceEvent/4.0.2
         API signatures reviewed at microsoft/perfview/tree/v4.0.2/src/TraceEvent. -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="[4.0.2]" />
  </ItemGroup>
</Project>
